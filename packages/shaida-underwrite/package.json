    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "test": "node --import tsx --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "decide": "tsx scripts/underwrite.ts",
    "fixture": "tsx scripts/gen-link-fixture.ts"
  },
  "dependencies": {
    "@shaida/index": "workspace:*",
    "@shaida/kv": "workspace:*",
    "@shaida/proofs": "workspace:*",
    "ffjavascript": "0.3.1",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6",
    "viem": "2.57.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@shaida/pay": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
