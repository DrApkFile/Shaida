pragma solidity ^0.8.24;

import {stdJson} from "forge-std/StdJson.sol";
import {ShaidaLedger} from "../src/ShaidaLedger.sol";
import {ShaidaBase} from "./helpers/ShaidaBase.sol";

/// The income circuit's V and S formulas equal what ShaidaLedger inserts. income-vectors.json is generated by
/// packages/shaida-proofs (scripts/gen-ledger-vectors.ts); its JS test proves an income witness over the same
/// leaves, so circuit == JS == contract. Re-generate with `pnpm vectors` in packages/shaida-proofs.
contract IncomeVectorsTest is ShaidaBase {
    using stdJson for string;

    string internal json;

    function setUp() public override {
        super.setUp();
        json = vm.readFile("test/fixtures/income-vectors.json");
    }

    function test_empty_ledger_root_equals_the_circuit_tree_empty_root() public view {
        assertEq(ledger.currentRoot(), json.readBytes32(".emptyRoot"));
    }

    function test_ledger_inserts_the_circuit_V_and_S_leaves_and_reaches_the_same_roots() public {
        uint32 id = _register(payer);
        assertEq(uint256(id), json.readUint(".payerId"));

        string[] memory kinds = json.readStringArray(".eventKinds");
        uint256[] memory notes = json.readUintArray(".eventNotes");
        bytes32[] memory cps = json.readBytes32Array(".paymentCommitments");
        bytes32[] memory nullifiers = json.readBytes32Array(".nullifiers");
        bytes32[] memory css = json.readBytes32Array(".sweepCommitments");
        bytes32[] memory leaves = json.readBytes32Array(".leaves");
        bytes32[] memory roots = json.readBytes32Array(".roots");

        for (uint256 i = 0; i < kinds.length; i++) {
            ShaidaLedger.TransferArgs memory t = _transfer(); // stub-verified; we set the fields that make the leaf
            uint256 n = notes[i];
            if (keccak256(bytes(kinds[i])) == keccak256("vouchedPay")) {
                t.newCommitments[0] = cps[n];
                vm.expectEmit(address(ledger));
                emit ShaidaLedger.Vouched(id, cps[n], i, leaves[i]);
                vm.prank(payer);
                ledger.vouchedPay(t);
            } else {
                t.nullifier = nullifiers[n];
                t.newCommitments[0] = css[n];
                vm.expectEmit(address(ledger));
                emit ShaidaLedger.Swept(nullifiers[n], css[n], i, leaves[i]);
                ledger.sweep(t);
            }
            assertEq(ledger.currentRoot(), roots[i], string.concat("root after event ", vm.toString(i)));
        }
    }
}
